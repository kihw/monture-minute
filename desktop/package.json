{
  "name": "monture-minute-desktop",
  "productName": "Monture Minute",
  "version": "2.0.0",
  "description": "Assistant d'élevage de montures pour DOFUS — version Windows",
  "author": "kihw",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.community.dofusbreedingtool",
    "productName": "Monture Minute",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "MontureMinute-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Monture Minute"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kihw",
        "repo": "monture-minute"
      }
    ]
  }
}
