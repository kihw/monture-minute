<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Mise à jour de l'app par son propre APK (docs/PLAN-MAJ.md, § 3) : installer, et le faire sans
       confirmation sur Android 12+ quand l'app se met à jour elle-même. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

  <application>
    <!-- Statut de la session d'installation (succès, confirmation demandée, échec). -->
    <receiver
      android:name="expo.modules.installateurapk.RecepteurInstallation"
      android:exported="false" />
    <!-- Après une mise à jour, Android ferme l'app sans pouvoir la rouvrir : une notification
         « touche pour rouvrir » prend le relais. -->
    <receiver
      android:name="expo.modules.installateurapk.RecepteurMiseAJour"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
