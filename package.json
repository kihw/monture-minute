{
  "name": "dofus-breeding-tool",
  "version": "1.1.0",
  "description": "Monture Minute — minuteur compact pour l'élevage de montures dans Dofus",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:vite": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:android": "tsc && vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build:android && cd android && gradlew.bat assembleDebug"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "electron-store": "^8.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "build": {
    "appId": "com.community.dofusbreedingtool",
    "productName": "Monture Minute",
    "extraResources": [
      {
        "from": "assets/monture-minute.ico",
        "to": "monture-minute.ico"
      },
      {
        "from": "assets/monture-minute.png",
        "to": "monture-minute.png"
      }
    ],
    "win": {
      "icon": "assets/monture-minute.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  }
}
